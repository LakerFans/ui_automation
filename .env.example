# Browser
BROWSER_BACKEND=mock
AGENT_BROWSER_BIN=agent-browser
ALLOWED_URL_PATTERNS=https://*,http://localhost*,http://127.0.0.1*

# Resolver
CONFIDENCE_THRESHOLD=0.85
CLARIFY_THRESHOLD=0.60
MAX_CLARIFY_ATTEMPTS=2
MAX_RETRIES=3

# Phase 1
USE_POSTGRES_CHECKPOINTER=false
POSTGRES_URI=postgresql://ui_test:ui_test@localhost:5432/ui_test
USE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ui-test-artifacts
REQUIRE_RISK_CONFIRMATION=true
